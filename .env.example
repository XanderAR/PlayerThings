# Copy to .env for local runs. On Railway, set these as service variables instead.

# Public https URL of this service, no trailing slash (Railway gives you one).
BASE_URL=https://your-app.up.railway.app

# Discord Developer Portal > your app > General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot tab > Reset Token. Only needed for `playradar register`.
DISCORD_BOT_TOKEN=

# https://steamcommunity.com/dev/apikey (use your BASE_URL's domain)
STEAM_API_KEY=

# 32+ random characters. PowerShell: -join ((1..48) | % { [char](Get-Random -Min 97 -Max 123) })
LINK_SECRET=

# Optional
APP_NAME=PlayRadar
DATABASE_PATH=data/playradar.db
PLAYTESTS_FILE=data/playtests.json
PLAYTESTS_SOURCE=public playtest pages
PLAYERGG_URL=https://player.gg
CONTACT=
AVATAR_URL=
SYNC_INTERVAL=12h
STEAM_DAILY_BUDGET=90000
